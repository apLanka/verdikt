{
  "$ref": "#/definitions/extraction-result",
  "definitions": {
    "extraction-result": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "claimId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "inputVersion": {
          "type": "integer",
          "minimum": 0
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "documentId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "section": {
                      "type": "string",
                      "minLength": 1
                    },
                    "excerpt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "documentId",
                    "section"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "field",
              "value",
              "confidence",
              "evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "missingDocuments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schemaVersion",
        "claimId",
        "runId",
        "attemptId",
        "inputVersion",
        "facts"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
